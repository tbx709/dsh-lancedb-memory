{
  "name": "dsh-lancedb-memory",
  "version": "0.5.1",
  "private": true,
  "type": "module",
  "description": "Embedded LanceDB memory for DSH: session-isolated storage, reusable souls, hybrid vector+BM25 recall",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@lancedb/lancedb": "^0.41.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "check": "node --check index.js && node --check client.js",
    "test": "node test/smoke.mjs",
    "test:edges": "node test/edges.mjs"
  },
  "license": "MIT",
  "author": "tbx709",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tbx709/dsh-lancedb-memory.git"
  },
  "homepage": "https://github.com/tbx709/dsh-lancedb-memory#readme"
}
